# Normalize to LF in the repository; check out native on Windows.
* text=auto

# Files that MUST stay LF even on Windows: CRLF breaks the shebang/parsing.
*.sh   text eol=lf
Makefile text eol=lf
Dockerfile text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.sql  text eol=lf

# Binary
*.pdf  binary
*.nc   binary
*.tif  binary
