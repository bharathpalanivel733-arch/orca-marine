{
  "$defs": {
    "ComponentHealth": {
      "additionalProperties": false,
      "description": "Condition of one dependency (database, cache, object store, upstream feed).",
      "properties": {
        "name": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/HealthStatus"
        },
        "detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Human-readable reason, required when not ok."
        },
        "latency_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "name",
        "status"
      ],
      "type": "object",
      "title": "ComponentHealth"
    },
    "HealthStatus": {
      "description": "Service or dependency condition.\n\n``degraded`` is a first-class state, not a soft failure: ORCA is designed to keep\noperating with missing or stale inputs and to say so (ARCHITECTURE.md \u00a77).",
      "enum": [
        "ok",
        "degraded",
        "down"
      ],
      "type": "string",
      "title": "HealthStatus"
    },
    "ProblemDetail": {
      "additionalProperties": false,
      "description": "Error payload (RFC 9457 shape) carrying the run id for support and replay.",
      "properties": {
        "type": {
          "default": "about:blank",
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "status": {
          "maximum": 599,
          "minimum": 100,
          "type": "integer"
        },
        "detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "run_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "title",
        "status"
      ],
      "type": "object",
      "title": "ProblemDetail"
    },
    "RunContext": {
      "additionalProperties": false,
      "description": "Identity of a single end-to-end run, propagated to every service and log line.",
      "properties": {
        "run_id": {
          "description": "Unique id for this run.",
          "type": "string"
        },
        "parent_run_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Set when this run was spawned by another run."
        },
        "service": {
          "description": "Service that created or received the run context.",
          "type": "string"
        },
        "started_at": {
          "format": "date-time",
          "type": "string"
        }
      },
      "required": [
        "service"
      ],
      "type": "object",
      "title": "RunContext"
    },
    "ServiceHealth": {
      "additionalProperties": false,
      "description": "Aggregate health of one ORCA service.",
      "properties": {
        "service": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/HealthStatus"
        },
        "checked_at": {
          "format": "date-time",
          "type": "string"
        },
        "components": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ComponentHealth"
          },
          "type": "array"
        }
      },
      "required": [
        "service",
        "version",
        "status"
      ],
      "type": "object",
      "title": "ServiceHealth"
    }
  },
  "title": "OrcaContracts"
}
