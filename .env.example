# ORCA — environment template (PLAN.md Phase 0.3)
# Copy to .env and fill in. NEVER commit .env.
# A blank value means "not configured"; services must degrade, not crash.

# ---------- Core infrastructure (matches infra/docker-compose.yml) ----------
ORCA_ENV=development
ORCA_LOG_LEVEL=INFO
ORCA_LOG_FORMAT=json                      # json | console

DATABASE_URL=postgresql://orca:orca@localhost:5432/orca
REDIS_URL=redis://localhost:6379/0

S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=orca-minio
S3_SECRET_ACCESS_KEY=orca-minio-secret
S3_BUCKET=orca-cache

# ---------- Observability (PLAN.md Phase 0.5) ----------
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=orca-api

# ---------- Marine data sources (PLAN.md Phase 1 — NOT used in Phase 0) ----------
# INCOIS ERDDAP: open, no key required.
INCOIS_ERDDAP_BASE_URL=https://erddap.incois.gov.in/erddap
# IMD: public JSON/GeoJSON, no data.gov.in key required. IMD asks for attribution + client caching.
IMD_API_BASE_URL=https://api.imd.gov.in/api/v1
# Open-Meteo Marine: keyless fallback.
OPEN_METEO_MARINE_BASE_URL=https://marine-api.open-meteo.com/v1
# Copernicus Marine (CMEMS): free account, no API key — username/password for the toolbox.
CMEMS_USERNAME=
CMEMS_PASSWORD=
# MOSDAC: SSO registration, no separate API key. Enhancement only; 3-day L1 latency.
MOSDAC_USERNAME=
MOSDAC_PASSWORD=

# ---------- Language / speech (PLAN.md Phase 7) ----------
# Read by services/api speech endpoints. Left blank, the ASR/TTS chains report the Bhashini
# provider unavailable and fall through to the documented fallbacks and the audio cache.
BHASHINI_USER_ID=
BHASHINI_ULCA_API_KEY=
BHASHINI_PIPELINE_ID=
# Object-store bucket for pre-generated alert and demo audio (scripts/pregenerate_audio.py).
SPEECH_AUDIO_BUCKET=orca-audio

# ---------- LLM providers (routing table lives in config/models.yaml) ----------
ANTHROPIC_API_KEY=
GROQ_API_KEY=
